# このファイルを .env にコピーして値を入れる:
#   cp .env.example .env
# 権限を絞る（Unix系のみ）:  chmod 600 .env

# 必須
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# Amazon PA-API (Creators API) — Amazonを監視するなら必須
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=tsumitsumi232-22

# 楽天API — 楽天を監視するなら必須
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# 任意（既定値。変えたいときだけ）
# INTERVAL_MS=300000                # チェック間隔 5分
# WATCHLIST_REFRESH_MS=300000       # watchlist再取得 5分
